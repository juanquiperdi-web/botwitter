# Twitter/X - solo usuario y contraseña, sin API keys
TWITTER_USERNAME=tu_usuario_de_twitter
TWITTER_EMAIL=tu_email_de_twitter
TWITTER_PASSWORD=tu_contraseña_de_twitter

# NewsAPI (newsapi.org - cuenta gratuita)
NEWS_API_KEY=tu_newsapi_key

# Groq (console.groq.com - gratuito, funciona en España/EU)
GROQ_API_KEY=tu_groq_api_key
